<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): allowBackup="false" no impide la copia de un teléfono a otro.
     Estas reglas excluyen todos los datos de la app de la copia en la nube y de la
     transferencia entre dispositivos (MASVS-STORAGE, Ley N.° 29733). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
